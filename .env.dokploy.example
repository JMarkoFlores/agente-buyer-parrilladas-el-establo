# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO — DOKPLOY (PRODUCCIÓN)
# Agente Inteligente Multicanal para la Captación y Conversión de BUYERS
# Parrilladas El Establo
# ==============================================================================
# INSTRUCCIONES:
# 1. En el panel de Dokploy, vaya a su proyecto Compose -> Pestaña "Environment".
# 2. Pegue estas variables y configure los valores correspondientes.
# 3. NUNCA suba un archivo .env con credenciales reales al repositorio Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MICROSOFT SQL SERVER 2022 EXPRESS
# ------------------------------------------------------------------------------
ACCEPT_EULA=Y
MSSQL_PID=Express
# Generar una contraseña segura (min 12 caracteres, mayúsculas, minúsculas, dígitos y símbolos)
MSSQL_SA_PASSWORD=CAMBIAR_POR_PASSWORD_SA_SEGURO_123!

# Credenciales de usuario de aplicación buyer_app
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=buyer
DB_USER=buyer_app
DB_PASSWORD=CAMBIAR_POR_PASSWORD_BUYER_APP_SEGURO_123!
DB_TRUSTED_CONNECTION=false
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------------------
# 2. FLASK BACKEND (WSGI GUNICORN)
# ------------------------------------------------------------------------------
FLASK_ENV=production
FLASK_PORT=5000
# Generar clave secreta criptográfica (ej: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CAMBIAR_POR_TOKEN_HEX_64_CARACTERES_ALEATORIOS
# Dominios autorizados para CORS separados por coma (incluir dominio configurado en Dokploy)
CORS_ORIGINS=https://buyer.tu-dominio.com,https://elestablo.giansmd.dev

# Clave de API para endpoints administrativos (/api/facebook/sincronizar, /api/auto-reply/*)
ADMIN_API_KEY=CAMBIAR_POR_API_KEY_ADMINISTRATIVA_SEGURA_32_CHARS

# ------------------------------------------------------------------------------
# 3. META GRAPH API (FACEBOOK PAGES & INSTAGRAM GRAPH API)
# ------------------------------------------------------------------------------
META_GRAPH_VERSION=v27.0
META_APP_ID=TU_META_APP_ID
META_APP_SECRET=TU_META_APP_SECRET_ROTADO
META_PAGE_ID=TU_META_PAGE_ID
META_PAGE_ACCESS_TOKEN=TU_META_PAGE_ACCESS_TOKEN_ROTADO
META_VERIFY_TOKEN=TU_VERIFY_TOKEN_OPCIONAL
META_HTTP_TIMEOUT=20

META_IG_ACCOUNT_ID=TU_META_IG_ACCOUNT_ID
META_IG_ACCESS_TOKEN=TU_META_IG_ACCESS_TOKEN_ROTADO
META_IG_LOGIN_TYPE=FACEBOOK_LOGIN

# ------------------------------------------------------------------------------
# 4. APSCHEDULER - PLANIFICADOR DE SINCRONIZACIÓN AUTOMÁTICA
# ------------------------------------------------------------------------------
# ATENCIÓN - MODO SEGURO PARA EL PRIMER DESPLIEGUE:
# Mantener META_SYNC_ENABLED=false hasta verificar que la base de datos esté restaurada
# y que el scheduler de Docker Desktop local haya sido detenido.
META_SYNC_ENABLED=false
META_SYNC_INTERVAL_MINUTES=1
META_SYNC_SCHEDULER_EMBEDDED=false
SCHEDULER_STANDALONE=false
SCHEDULER_LOCK_TYPE=sql_server

# ------------------------------------------------------------------------------
# 5. AGENTE DE RESPUESTAS AUTOMÁTICAS (AUTO-REPLY)
# ------------------------------------------------------------------------------
AUTO_REPLY_ENABLED=true
# ATENCIÓN: Mantener AUTO_REPLY_DRY_RUN=true durante la validación inicial en Dokploy.
# Solo cambiar a false una vez que se verifique la estabilidad y el apagado local.
AUTO_REPLY_DRY_RUN=true
AUTO_REPLY_REQUIRE_REVIEW=false
AUTO_REPLY_FACEBOOK_ENABLED=true
AUTO_REPLY_INSTAGRAM_ENABLED=true
AUTO_REPLY_FORM_URL=https://elestablo.giansmd.dev/registro/
AUTO_REPLY_INCLUDE_FORM_URL=true
AUTO_REPLY_LANDING_URL=https://elestablo.giansmd.dev/
AUTO_REPLY_MAX_PER_CYCLE=5
AUTO_REPLY_COOLDOWN_HOURS=24
