{
  "folders": {},
  "connections": {
    "establo-buyer-sqlserver": {
      "provider": "sqlserver",
      "driver": "microsoft",
      "name": "SQL Server buyer (establo)",
      "description": "Conexion preconfigurada para Parrilladas El Establo - buyer",
      "save-password": true,
      "read-only": false,
      "configuration": {
        "host": "sqlserver",
        "port": "1433",
        "database": "buyer",
        "url": "jdbc:sqlserver://sqlserver:1433;databaseName=buyer;encrypt=true;trustServerCertificate=true;",
        "configurationType": "MANUAL",
        "type": "dev",
        "auth-model": "sqlserver_database"
      },
      "auth-properties": {
        "userName": "sa",
        "userPassword": "__MSSQL_SA_PASSWORD__"
      }
    }
  },
  "connection-types": {
    "dev": {
      "name": "Development",
      "color": "255,255,255",
      "description": "Base de datos buyer",
      "auto-commit": true,
      "confirm-execute": false,
      "confirm-data-change": false,
      "read-only": false
    }
  }
}
