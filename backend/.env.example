# ==============================================================================
# CONFIGURACIÓN DEL AGENTE INTELIGENTE BUYER - PARRILLADAS EL ESTABLO
# ==============================================================================

# Entorno Flask
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=dev-secret-key-establo-buyer-2026

# Conexión a Microsoft SQL Server
DB_SERVER=localhost
# DB_PORT: Dejar vacío para conexiones locales (Shared Memory / Named Pipes).
# Si TCP/IP está habilitado en SQL Server Configuration Manager, use 1433.
DB_PORT=
DB_NAME=buyer
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=true
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# INTEGRACIÓN META GRAPH API (FACEBOOK PAGES)
# ==============================================================================
META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_HTTP_TIMEOUT=20

# Token local de administración para proteger la sincronización manual
ADMIN_API_KEY=admin-establo-buyer-secret-2026

# ==============================================================================
# INTEGRACIÓN META GRAPH API (INSTAGRAM)
# ==============================================================================
META_IG_ACCOUNT_ID=
META_IG_LOGIN_TYPE=FACEBOOK_LOGIN
META_IG_ACCESS_TOKEN=

# ==============================================================================
# AUTOMATIZACIÓN DE AGENTES Y SINCRONIZACIÓN AUTOMÁTICA
# ==============================================================================
META_SYNC_ENABLED=true
# Intervalo en segundos (por ejemplo 10 segundos). Tiene prioridad sobre META_SYNC_INTERVAL_MINUTES si ambas están presentes.
META_SYNC_INTERVAL_SECONDS=10
# Intervalo en minutos (compatibilidad heredada, por ejemplo 1 o 10 minutos)
META_SYNC_INTERVAL_MINUTES=1

# ==============================================================================
# AGENTE DE RESPUESTAS AUTOMÁTICAS (AUTO-REPLY)
# ==============================================================================
AUTO_REPLY_ENABLED=false
AUTO_REPLY_DRY_RUN=true
AUTO_REPLY_REQUIRE_REVIEW=true

AUTO_REPLY_FACEBOOK_ENABLED=true
AUTO_REPLY_INSTAGRAM_ENABLED=true

AUTO_REPLY_FORM_URL=https://elestablo.giansmd.dev/registro/
AUTO_REPLY_LANDING_URL=https://elestablo.giansmd.dev/

AUTO_REPLY_MAX_PER_CYCLE=5
AUTO_REPLY_COOLDOWN_HOURS=24


