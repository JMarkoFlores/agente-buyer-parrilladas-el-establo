# ==============================================================================
# CONFIGURACIÓN DEL AGENTE INTELIGENTE BUYER - PARRILLADAS EL ESTABLO
# ==============================================================================

# Entorno Flask
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=dev-secret-key-establo-buyer-2026

# Conexión a Microsoft SQL Server
DB_SERVER=localhost
# DB_PORT: Dejar vacío para conexiones locales (Shared Memory / Named Pipes).
# Si TCP/IP está habilitado en SQL Server Configuration Manager, use 1433.
DB_PORT=
DB_NAME=buyer
DB_USER=
DB_PASSWORD=
DB_TRUSTED_CONNECTION=true
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ==============================================================================
# INTEGRACIÓN META GRAPH API (FACEBOOK PAGES)
# ==============================================================================
META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_HTTP_TIMEOUT=20

# Token local de administración para proteger la sincronización manual
ADMIN_API_KEY=admin-establo-buyer-secret-2026

