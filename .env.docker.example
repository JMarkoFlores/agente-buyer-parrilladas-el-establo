# ==============================================================================
# CONFIGURACIÓN DOCKER COMPOSE - AGENTE BUYER (PARRILLADAS EL ESTABLO)
# Archivo de ejemplo para despliegue en contenedores.
# Copiar este archivo como .env en la raiz antes de ejecutar docker compose:
#   cp .env.docker.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MICROSOFT SQL SERVER 2022 EXPRESS
# ------------------------------------------------------------------------------
ACCEPT_EULA=Y
MSSQL_PID=Express
MSSQL_SA_PASSWORD=EstabloBuyer2026!DbPass

DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=buyer
DB_USER=buyer_app
DB_PASSWORD=EstabloBuyer2026!DbPass
DB_TRUSTED_CONNECTION=false
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUST_SERVER_CERTIFICATE=true

# ------------------------------------------------------------------------------
# 2. FLASK BACKEND (WSGI GUNICORN)
# ------------------------------------------------------------------------------
FLASK_ENV=production
FLASK_PORT=5000
SECRET_KEY=establo-buyer-secret-production-key-2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4321,http://127.0.0.1:4321

# Puerto local del contenedor landing
LANDING_PORT=4321

# ------------------------------------------------------------------------------
# 3. META GRAPH API (FACEBOOK PAGES & INSTAGRAM)
# ------------------------------------------------------------------------------
META_GRAPH_VERSION=v27.0
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_HTTP_TIMEOUT=20

META_IG_ACCOUNT_ID=
META_IG_ACCESS_TOKEN=
META_IG_LOGIN_TYPE=FACEBOOK_LOGIN

# Token de administracion para endpoints protegidos
ADMIN_API_KEY=admin-establo-buyer-secret-2026

# ------------------------------------------------------------------------------
# 4. APSCHEDULER - SINCRONIZACIÓN AUTOMÁTICA
# ------------------------------------------------------------------------------
META_SYNC_ENABLED=true
META_SYNC_INTERVAL_MINUTES=1
META_SYNC_SCHEDULER_EMBEDDED=false
SCHEDULER_STANDALONE=true
SCHEDULER_LOCK_TYPE=sql_server

# ------------------------------------------------------------------------------
# 5. AGENTE DE RESPUESTAS AUTOMÁTICAS (AUTO-REPLY)
# ------------------------------------------------------------------------------
AUTO_REPLY_ENABLED=true
AUTO_REPLY_DRY_RUN=false
AUTO_REPLY_REQUIRE_REVIEW=false
AUTO_REPLY_FACEBOOK_ENABLED=true
AUTO_REPLY_INSTAGRAM_ENABLED=true
AUTO_REPLY_FORM_URL=https://elestablo.giansmd.dev/registro/
AUTO_REPLY_INCLUDE_FORM_URL=true
AUTO_REPLY_LANDING_URL=https://elestablo.giansmd.dev/
AUTO_REPLY_MAX_PER_CYCLE=5
AUTO_REPLY_COOLDOWN_HOURS=24
