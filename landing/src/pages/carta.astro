---
import Base from '../layouts/Base.astro';
import Carta from '../components/Carta.astro';
import { NEGOCIO } from '../app/domain/models/negocio.model';
---

<Base
  title={`Carta · ${NEGOCIO.nombre}`}
  description="Consulta la carta completa de Parrilladas El Establo: cortes finos de res y cerdo, combos para compartir, ensaladas, bebidas y vinos al carbón en Trujillo."
>
  <header class="sticky top-0 z-40 border-b border-crema/10 bg-carbon/80 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
      <a href="/" class="flex items-center gap-2.5">
        <svg viewBox="0 0 24 24" class="h-7 w-7 fill-brasa-light" aria-hidden="true">
          <path d="M12 2c.6 2.8-.7 4.2-2.2 5.7C8.1 9.4 6.5 11 6.5 13.6A5.5 5.5 0 0 0 12 19a5.5 5.5 0 0 0 5.5-5.4c0-1.3-.4-2.4-1-3.4-.4.9-1 1.6-1.7 2 .3-2.6-.8-5.3-2.8-6.9V2Z" />
        </svg>
        <span class="font-display text-xl leading-none tracking-wider">
          Parrilladas<br /><span class="text-brasa-light">El Establo</span>
        </span>
      </a>
      <nav aria-label="Navegación principal" class="hidden items-center gap-8 text-sm text-crema/75 sm:flex">
        <a href="/" class="transition hover:text-crema">Volver al inicio</a>
        <a href="/#reservas" class="transition hover:text-crema">Reservas</a>
        <a href="/#local" class="transition hover:text-crema">El local</a>
      </nav>
      <div class="flex items-center gap-3">
        <a href="/" class="text-sm text-crema/75 transition hover:text-crema sm:hidden">
          Volver al inicio
        </a>
        <a
          href={NEGOCIO.formularioUrl}
          class="rounded-full bg-brasa px-4 py-2 text-sm font-medium text-crema transition hover:bg-brasa-light"
        >
          Reservar
        </a>
      </div>
    </div>
  </header>

  <main id="contenido">
    <div class="mx-auto max-w-6xl px-5 pt-8 sm:px-8 sm:pt-10">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-crema/60 transition hover:text-crema"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4 fill-none stroke-current stroke-2" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Volver al inicio
      </a>
    </div>

    <Carta />
  </main>

  <footer class="border-t border-crema/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-5 py-8 text-xs text-crema/40 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>© {new Date().getFullYear()} {NEGOCIO.nombre}. Todos los derechos reservados.</p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <a href="/" class="underline decoration-crema/20 underline-offset-4 hover:text-crema/70">Volver al inicio</a>
        <a href={NEGOCIO.formularioUrl} class="underline decoration-crema/20 underline-offset-4 hover:text-crema/70">Reservar mesa</a>
        <a href="/privacidad" class="underline decoration-crema/20 underline-offset-4 hover:text-crema/70">Política de privacidad</a>
        <a href="/creditos" class="underline decoration-crema/20 underline-offset-4 hover:text-crema/70">Créditos de imágenes</a>
      </p>
    </div>
  </footer>
</Base>
