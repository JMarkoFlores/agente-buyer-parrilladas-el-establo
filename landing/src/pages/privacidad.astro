---
import Base from '../layouts/Base.astro';
import { NEGOCIO, enlaceWhatsApp } from '../app/domain/models/negocio.model';

const secciones = [
  {
    titulo: 'Qué datos recolectamos',
    texto: 'Nombres, apellidos, celular, correo electrónico y fecha de nacimiento (opcional). También registramos desde qué canal llegaste (por ejemplo, una publicación de Facebook o Instagram) y el plato que marcaste como favorito.',
  },
  {
    titulo: 'Para qué los usamos',
    texto: 'Para gestionar tu reserva, contactarte por WhatsApp o correo y atenderte mejor. Si marcas la casilla de promociones, también para enviarte novedades y ofertas del local.',
  },
  {
    titulo: 'Base legal',
    texto: 'Tratamos tus datos con tu consentimiento previo e informado, conforme a la Ley N.º 29733, Ley de Protección de Datos Personales, y su reglamento.',
  },
  {
    titulo: 'Cuánto tiempo los guardamos',
    texto: 'Mientras se mantenga la relación comercial o hasta que solicites su eliminación, salvo que una norma exija conservarlos por más tiempo.',
  },
  {
    titulo: 'Tus derechos',
    texto: 'Puedes ejercer tus derechos de acceso, rectificación, cancelación y oposición (ARCO) escribiéndonos por WhatsApp. También puedes retirar tu consentimiento para el envío de promociones en cualquier momento.',
  },
];
---

<Base
  title={`Política de privacidad · ${NEGOCIO.nombre}`}
  description="Cómo tratamos los datos personales que nos compartes al registrarte en Parrilladas El Establo."
>
  <header class="border-b border-crema/10 bg-carbon/80 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5 sm:px-8">
      <a href="/" class="flex items-center gap-2.5">
        <span class="font-display text-xl leading-none tracking-wider">
          Parrilladas<br /><span class="text-brasa-light">El Establo</span>
        </span>
      </a>
      <a href="/registro" class="text-sm text-crema/60 transition hover:text-crema">Volver al registro</a>
    </div>
  </header>

  <main id="contenido" class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <p class="font-sans text-xs uppercase tracking-[0.3em] text-brasa-light">Privacidad</p>
    <h1 class="mt-3 font-display text-5xl leading-none sm:text-6xl">Política de privacidad</h1>
    <p class="mt-5 max-w-xl text-crema/65">
      Responsable del tratamiento: {NEGOCIO.nombre}, {NEGOCIO.direccion}, {NEGOCIO.ciudad}.
    </p>

    <div class="mt-10 space-y-8">
      {
        secciones.map((seccion) => (
          <section>
            <h2 class="font-display text-2xl tracking-wide text-ambar">{seccion.titulo}</h2>
            <p class="mt-2 text-crema/65">{seccion.texto}</p>
          </section>
        ))
      }
      <section>
        <h2 class="font-display text-2xl tracking-wide text-ambar">Contacto</h2>
        <p class="mt-2 text-crema/65">
          Para cualquier consulta sobre tus datos personales, escríbenos por
          <a
            href={enlaceWhatsApp('¡Hola! Tengo una consulta sobre mis datos personales.')}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ambar underline decoration-ambar/40 underline-offset-4 hover:decoration-ambar">WhatsApp</a>.
        </p>
      </section>
    </div>
  </main>
</Base>
