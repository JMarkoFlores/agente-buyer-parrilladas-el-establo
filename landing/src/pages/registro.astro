---
import Base from '../layouts/Base.astro';
import FormularioCaptacion from '../components/FormularioCaptacion.astro';
import { NEGOCIO } from '../app/domain/models/negocio.model';
---

<Base
  title={`Registro de clientes · ${NEGOCIO.nombre}`}
  description="Registra tus datos para reservar tu mesa en Parrilladas El Establo y recibe nuestras promociones."
>
  <header class="border-b border-crema/10 bg-carbon/80 backdrop-blur">
    <div class="mx-auto flex h-16 max-w-3xl items-center justify-between px-5 sm:px-8">
      <a href="/" class="flex items-center gap-2.5">
        <svg viewBox="0 0 24 24" class="h-7 w-7 fill-brasa-light" aria-hidden="true">
          <path d="M12 2c.6 2.8-.7 4.2-2.2 5.7C8.1 9.4 6.5 11 6.5 13.6A5.5 5.5 0 0 0 12 19a5.5 5.5 0 0 0 5.5-5.4c0-1.3-.4-2.4-1-3.4-.4.9-1 1.6-1.7 2 .3-2.6-.8-5.3-2.8-6.9V2Z" />
        </svg>
        <span class="font-display text-xl leading-none tracking-wider">
          Parrilladas<br /><span class="text-brasa-light">El Establo</span>
        </span>
      </a>
      <a href="/" class="text-sm text-crema/60 transition hover:text-crema">Volver a la carta</a>
    </div>
  </header>

  <main id="contenido" class="mx-auto max-w-3xl px-5 py-14 sm:px-8 sm:py-20">
    <p class="font-sans text-xs uppercase tracking-[0.3em] text-brasa-light">Registro de clientes</p>
    <h1 class="mt-3 font-display text-5xl leading-none sm:text-6xl">Reserva tu mesa</h1>
    <p class="mt-5 max-w-xl text-crema/65">
      Déjanos tus datos y te escribimos por WhatsApp para confirmar disponibilidad. Toma menos de un minuto.
    </p>

    <div class="mt-10">
      <FormularioCaptacion />
    </div>

    <p class="mt-8 text-xs text-crema/40">
      Tus datos se usan solo para gestionar tu reserva y, si lo autorizas, enviarte promociones.
      Puedes solicitar su eliminación escribiéndonos a {NEGOCIO.nombre}.
    </p>
  </main>

  <footer class="border-t border-crema/10">
    <div class="mx-auto flex max-w-3xl flex-col gap-2 px-5 py-8 text-xs text-crema/40 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>© {new Date().getFullYear()} {NEGOCIO.nombre}.</p>
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <a href="/privacidad" class="underline decoration-crema/20 underline-offset-4 hover:text-crema/70">Política de privacidad</a>
        <a href="/creditos" class="underline decoration-crema/20 underline-offset-4 hover:text-crema/70">Créditos de imágenes</a>
      </p>
    </div>
  </footer>
</Base>
